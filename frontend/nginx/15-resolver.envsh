#!/bin/sh
# Sourced by the nginx image entrypoint before templates are rendered.
# Uses the container's own DNS server (Docker: 127.0.0.11, Render: its VPC resolver)
# unless NGINX_RESOLVER is set explicitly.
if [ -z "${NGINX_RESOLVER:-}" ]; then
  NGINX_RESOLVER=$(awk '/^nameserver/ { print $2; exit }' /etc/resolv.conf)
  case "$NGINX_RESOLVER" in
    *:*) NGINX_RESOLVER="[$NGINX_RESOLVER]" ;;
  esac
  export NGINX_RESOLVER
fi
