# Copy to .env for `docker compose`. Never commit .env.

# --- database ---
POSTGRES_USER=blogflow
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_DB=blogflow

# --- backend ---
# generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h
LOG_LEVEL=info
RATE_LIMIT_MAX=1000

# --- frontend ---
FRONTEND_PORT=8080

# --- monitoring (docker compose --profile monitoring) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# optional: Slack/Discord/Teams-compatible webhook for Grafana alerts
ALERT_WEBHOOK_URL=

