# Rendered by the nginx image's entrypoint (envsubst) into /etc/nginx/conf.d/default.conf.
# API_UPSTREAM: http://backend:3000 (compose) or https://blogflow-api.<env>.azurecontainerapps.io (Azure)

# the container's DNS server — see 15-resolver.envsh
resolver ${NGINX_RESOLVER} valid=30s ipv6=off;

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    client_max_body_size 1m;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
    gzip_min_length 1024;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # container / platform health probe for the web tier itself
    location = /healthz {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    # backend health surfaced to the SPA's status page
    location = /api/health {
        set $upstream ${API_UPSTREAM};
        proxy_pass $upstream/health;
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
    }

    # reverse-proxy the API — the browser only ever talks to this origin (no CORS)
    location /api/ {
        # variable upstream → resolved per request, so nginx starts even if the API is still booting
        set $upstream ${API_UPSTREAM};
        proxy_pass $upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_ssl_server_name on;
        proxy_read_timeout 30s;
    }

    # fingerprinted build assets — cache forever
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # SPA fallback: client-side routes resolve to index.html, which is never cached
    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        try_files $uri $uri/ /index.html;
    }
}
