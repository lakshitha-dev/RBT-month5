PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Either a single connection string (compose / Neon)...
DATABASE_URL=postgres://blogflow:blogflow@localhost:5432/blogflow
# ...or the individual Month 2 variables (used when DATABASE_URL is empty)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=blogflow
# DB_USER=postgres
# DB_PASSWORD=your_password_here
DB_SSL=false
DB_POOL_MAX=10
RUN_MIGRATIONS=true

JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=24h

# comma-separated allowed origins; empty = allow all
CORS_ORIGIN=
RATE_LIMIT_MAX=100
TRUST_PROXY=1
# when set, GET /metrics requires "Authorization: Bearer <token>"
METRICS_TOKEN=
